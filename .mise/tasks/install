#!/usr/bin/env bash
#MISE description="Install a lab: contract, roster, queue, style, guard, steward and tasks — a new directory, a repo of its own"
#USAGE arg "[name]" help="Lab name, lowercase (for example: example); without one, install asks"
#USAGE flag "--at <path>" help="Where to create it; defaults to ./<name> — must not exist yet"
#USAGE flag "--project <project>" help="What the lab works on; defaults to the lab name"
#USAGE flag "--owner <owner>" help="The owner's name as it appears in the contract; defaults to git user.name, and is required when that is unset"
#USAGE flag "--no-commit" help="Leave the generated files uncommitted"
#USAGE example "peninsula install" header="Ask for each fact, then scaffold a lab and offer agents, hooks and a first check"
#USAGE example "peninsula install example --at ~/example --owner 'Your Name'" header="A lab that works on other repos"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/peninsula.sh"

NAME="${usage_name:-}"

if [ -z "$NAME" ]; then
  # Guided: every flag is still an answer; what is missing is asked of the
  # owner, on $PENINSULA_PROMPT_TTY, else /dev/tty, else stdin.
  if lab="$(lab_root_up "$(caller_pwd)")"; then
    say "$(display_path "$lab") is already the $(lab_name "$lab") lab — 'peninsula doctor --lab $(display_path "$lab")' checks it"
    exit 0
  fi

  ask_open || die "install with no name asks — it needs a terminal, or answers on stdin"

  default_name="$(basename "$(caller_pwd)" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
  NAME="$(ask_input "Lab name" "$default_name")" || die "install with no name asks — it needs a terminal, or answers on stdin"
  until ( validate_name "lab name" "$NAME" ) 2>/dev/null; do
    NAME="$(ask_input "Lab name — lowercase letters, digits, hyphens" "$default_name")" || die "install needs a lab name"
  done

  AT="${usage_at:-}"
  if [ -z "$AT" ]; then
    AT="$(ask_input "Where does it live" "$(caller_pwd)/$NAME")" || die "install needs a path"
  fi

  PROJECT="${usage_project:-}"
  if [ -z "$PROJECT" ]; then
    PROJECT="$(ask_input "What does it work on" "$NAME")" || die "install needs a project"
  fi

  OWNER="${usage_owner:-}"
  if [ -z "$OWNER" ]; then
    owner_default="$(git config user.name 2>/dev/null || true)"  # codebase:ignore or-true — user.name may be unset; the next line names the remedy
    OWNER="$(ask_input "Owner — the human the contract names" "$owner_default")" || die "install needs the owner's name"
    [ -n "$OWNER" ] || die "the owner has no name: pass --owner '<name>', or set git config user.name"
  fi

  say ""
  say "  $NAME — $(display_path "$(resolve_path "$AT")")"
  say "  a repo of its own, working on $PROJECT"
  say "  owner: $OWNER"
  say ""
  if ! peninsula_yes && ! ask_confirm "Create it?"; then
    say "nothing written"
    exit 1
  fi

  lab_at="$(resolve_path "$AT")"
  args=("$NAME" --at "$lab_at" --owner "$OWNER" --project "$PROJECT")
  [ "${usage_no_commit:-false}" = true ] && args+=(--no-commit)
  mise -C "$MISE_CONFIG_ROOT" run -q install ${args[@]+"${args[@]}"}
  lab_at="$(cd "$lab_at" && pwd -P)"

  say ""
  while ask_confirm "Add an agent to the roster?" n; do
    agent="$(ask_input "Agent name")" || break
    until ( [ -n "$agent" ] && validate_name "agent name" "$agent" ) 2>/dev/null; do
      agent="$(ask_input "Agent name — lowercase letters, digits, hyphens")" || break 2
    done
    if roster_has "$lab_at" "$agent"; then
      err "$agent is already on the roster"
      continue
    fi
    case "$(ask_choice "What does $agent do?" \
      "builder — owns a directory under the work tree" \
      "judge — owns no directory; it reviews")" in
      builder*)
        owns="$(ask_input "Directory it owns" "src/")" || break
        [ -n "$owns" ] || { err "a builder needs a directory — skipping $agent"; continue; }
        ;;
      *) owns="" ;;
    esac
    role="$(ask_input "Its role, in two or three words")" || break
    [ -n "$role" ] || { err "an agent needs a role — skipping $agent"; continue; }
    charge="$(ask_input "Its charge, in one sentence")" || charge=""
    add_agent "$lab_at" "$agent" "$role" "$owns" "$charge"
  done

  say ""
  if peninsula_yes || ask_confirm "Install the lab's hooks (agent-identity + notes)?"; then
    mise -C "$lab_at" run -q install-hooks
  fi
  if peninsula_yes || ask_confirm "Print the welcome note?"; then
    mise -C "$lab_at" run -q welcome
  fi
  if peninsula_yes || ask_confirm "Check it with peninsula doctor?"; then
    mise -C "$MISE_CONFIG_ROOT" run -q doctor --lab "$lab_at"
  fi

  say ""
  say "done: $NAME at $(display_path "$lab_at")"
  exit 0
fi

validate_name "lab name" "$NAME"
UPPER="$(upper_env "$NAME")"

OWNER="${usage_owner:-$(git config user.name 2>/dev/null || true)}"  # codebase:ignore or-true — user.name may be unset; the next line names the remedy
[ -n "$OWNER" ] || die "the owner has no name: pass --owner '<name>', or set git config user.name"

AUTHOR_DOMAIN="$NAME.invalid"

# Install makes a new directory and its repo — never a lab inside an
# existing one and never files among the owner's own.
TARGET="$(resolve_path "${usage_at:-$NAME}")"
[ ! -e "$TARGET" ] || die "$(display_path "$TARGET") already exists — install makes a new directory"
TARGET="$(canonical_path "$TARGET")"
WORK="$TARGET"
PROJECT="${usage_project:-$NAME}"

VARS=(
  "LAB_NAME=$NAME"
  "LAB_UPPER=$UPPER"
  "LAB_PATH=$(display_path "$TARGET")"
  "WORK_PATH=$(display_path "$WORK")"
  "PROJECT=$PROJECT"
  "CREATED=$(today)"
  "AUTHOR_DOMAIN=$AUTHOR_DOMAIN"
  "OWNER=$OWNER"
  "FRAMEWORK_VERSION=$(framework_version)"
)

git -C "$TARGET" init -q -b main
say "init: git repo at $(display_path "$TARGET")"

install_tree "$PENINSULA_SCAFFOLD/lab" "$TARGET" "${VARS[@]+"${VARS[@]}"}"
install_tree "$PENINSULA_SCAFFOLD/work" "$WORK" "${VARS[@]+"${VARS[@]}"}"

mise trust "$TARGET/mise.toml" >/dev/null

add_agent "$TARGET" "$STEWARD" stewardship "" ""

# .agents/notes encrypts at rest before anything lands in history: notes
# wires git-crypt (provided by rudi) for the lab's notes dir. PATH tools win;
# the lab's own pins in mise.toml cover a machine that only has mise.
notes_dir="$(notes_dir_rel "$TARGET" "$WORK")"
if git -C "$WORK" check-attr filter -- "$notes_dir/queue.md" 2>/dev/null | grep -q 'git-crypt'; then
  say "keep: $notes_dir already encrypts at rest"
else
  (
    cd "$TARGET"
    export PATH="$HOME/.local/bin:$PATH"
    unset MISE_CONFIG_ROOT
    if command -v notes >/dev/null 2>&1 && command -v rudi >/dev/null 2>&1 && command -v git-crypt >/dev/null 2>&1; then
      notes setup --yes --dir "$notes_dir"
    else
      mise install --yes
      command -v git-crypt >/dev/null 2>&1 || mise exec -- rudi install
      mise exec -- notes setup --yes --dir "$notes_dir"
    fi
  ) || die "notes setup failed for $notes_dir — install the tools ahead (shiv install notes rudi; rudi install) and rerun install"
  say "encrypt: $notes_dir — readable in this checkout, opaque in git"
fi

# The first commit lands through the notes hooks; patch them before it
# (install-hooks does the same, and adds the guard, when the owner runs it).
hooks_dir="$(git -C "$WORK" rev-parse --git-path hooks)"
case "$hooks_dir" in /*) ;; *) hooks_dir="$WORK/$hooks_dir" ;; esac
patch_notes_hooks "$hooks_dir"

if [ "${usage_no_commit:-false}" = "true" ]; then
  say "skip: initial commit (--no-commit)"
else
  if signing="$(signing_describe "$TARGET")"; then
    say "sign: the bootstrap commit is signed ($signing); a passphrase prompt that appears now is for it. --no-commit leaves the files for the owner to commit instead"
  fi
  git -C "$TARGET" add .
  env "${UPPER}_OWNER_COMMIT=1" git -C "$TARGET" commit -q -m "$NAME: bootstrap the lab from peninsula"
  say "commit: bootstrap the lab"
fi

say ""
say "done: $NAME at $(display_path "$TARGET")"
say "next: peninsula agent add <name> --lab $(display_path "$TARGET") --role '<role>' [--owns <dir>/]"
say "next: cd $(display_path "$TARGET") && mise run install-hooks && mise run welcome"
