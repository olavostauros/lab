#!/usr/bin/env bash
#MISE description="Put an agent on a lab's roster: identity note and home repo"
#USAGE arg "<name>" help="Agent name, lowercase (for example: vulcan); 'steward' is the steward"
#USAGE flag "--lab <path>" help="The lab directory; defaults to the current directory"
#USAGE flag "--role <role>" help="Two or three words: what the agent is for; defaults to 'stewardship' for the steward"
#USAGE flag "--owns <dir>" help="Directory under the work tree a builder owns, with a trailing slash; without it the agent is a judge"
#USAGE flag "--charge <charge>" help="One sentence on what the agent does; defaults to a sentence built from the kind"
#USAGE example "lab agent add vulcan --role backend --owns server/ --charge 'Owns the schema, the domain model and the API.'" header="A builder"
#USAGE example "lab agent add argus --role 'review and security' --charge 'Reads every pull request into main before the owner merges it.'" header="A judge"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/lab.sh"

NAME="${usage_name:?an agent name is required}"
LAB="$(lab_root "${usage_lab:-.}")"
OWNS="${usage_owns:-}"
KIND="$(agent_kind "$NAME" "$OWNS")"
ROLE="${usage_role:-}"
if [ -z "$ROLE" ] && [ "$KIND" = steward ]; then ROLE=stewardship; fi
[ -n "$ROLE" ] || die "--role is required"

add_agent "$LAB" "$NAME" "$ROLE" "$OWNS" "${usage_charge:-}"

say ""
say "done: $NAME joins $(lab_name "$LAB") as $ROLE"
if [ "$KIND" = steward ]; then
  say "next: wake it once and let it report; its first sweep is the lab's first audit"
else
  say "next: read notes/$NAME.md — its Stance is the framework's for a $KIND, and narrowing it is $NAME's — then commit the lab as the owner"
  say "next: file the agent's first entry in notes/work-queue.md, addressed to $NAME"
fi
